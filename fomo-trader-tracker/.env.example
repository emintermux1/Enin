# --- Solana access -----------------------------------------------------------
# The public endpoint works but rate limits hard. A free Helius/QuickNode key
# makes discovery roughly an order of magnitude faster.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RPC_MIN_SPACING_MS=120
RPC_MAX_CONCURRENCY=4

# --- Discovery ---------------------------------------------------------------
# fomo-specific accounts every fomo trade touches (router / gas sponsor / fee
# recipient). Traders are enumerated from these. Comma separated.
FOMO_ROUTER_ACCOUNTS=

# Known fomo wallets. Used to derive FOMO_ROUTER_ACCOUNTS automatically:
#   npm run discover-router
# Two or more wallets give a much cleaner result.
FOMO_SEED_WALLETS=

# Wallets to always track regardless of discovery.
FOMO_MANUAL_WALLETS=

SIGNATURES_PER_ROUTER_SCAN=300
MAX_CANDIDATES_PER_CYCLE=400

# --- Filter criteria ---------------------------------------------------------
MIN_PORTFOLIO_USD=3000
MIN_MEMECOINS=5
MAX_MEMECOINS=10
MIN_TRADES_IN_WINDOW=5
ACTIVITY_WINDOW_DAYS=7
# Positions below this are treated as leftovers, not real memecoin holdings.
DUST_THRESHOLD_USD=25

# --- Monitoring --------------------------------------------------------------
DISCOVERY_INTERVAL_MS=3600000
REFRESH_INTERVAL_MS=3600000
ACTIVITY_POLL_INTERVAL_MS=300000
MAX_WATCHLIST_SIZE=1000
MIN_TRADE_ALERT_USD=500

# --- Telegram (optional; without it alerts are logged to stdout) -------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Token classification overrides -----------------------------------------
# Extra mints that should not count as memecoins.
MAJOR_MINTS_EXTRA=
STABLE_MINTS_EXTRA=

DB_PATH=data/fomo-tracker.db

# Portfolio-relative significance floor for counting a memecoin position.
MIN_POSITION_SHARE=0.01

# Jupiter free tier allows roughly one request per second.
PRICE_MIN_SPACING_MS=1500
MAX_MINTS_PRICED_PER_WALLET=400

# fomo-launched token mints (end in "fomo") to bootstrap holder discovery.
FOMO_SEED_MINTS=
FOMO_MINTS_PER_CYCLE=15
