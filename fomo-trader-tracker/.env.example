# --- Solana access -----------------------------------------------------------
# Strongly prefer a single paid/keyed endpoint. Public ones throttle hard and
# disable some methods, which makes discovery unreliable at any real scale.
SOLANA_RPC_URL=
# Fallback: rotate several endpoints. Each gets a 60s cooldown on 429 or stall.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
RPC_MIN_SPACING_MS=120
RPC_MAX_CONCURRENCY=4
RPC_TIMEOUT_MS=30000

# --- Discovery ---------------------------------------------------------------
# Gas sponsors that pay fees for app traders. Their co-signers are the trader
# population and this is the primary discovery path. Defaults to the DFlow
# gasless relayer that fomo trades through. Set to "none" to disable.
FOMO_SPONSOR_ACCOUNTS=
SIGNATURES_PER_SPONSOR_SCAN=500

# Extra accounts to enumerate traders from. fomo deploys no router program of
# its own (see README), so leave this empty unless you have your own lead.
FOMO_ROUTER_ACCOUNTS=

# Known fomo wallets. Used to derive FOMO_ROUTER_ACCOUNTS automatically:
#   npm run discover-router
# Two or more wallets give a much cleaner result.
FOMO_SEED_WALLETS=

# Wallets to always track regardless of discovery.
FOMO_MANUAL_WALLETS=

SIGNATURES_PER_ROUTER_SCAN=300
MAX_CANDIDATES_PER_CYCLE=400

# Wallets screened in parallel. Past ~6 this only helps on a paid RPC endpoint;
# free public endpoints saturate first. See the capacity table in the README.
SCAN_CONCURRENCY=6

# --- Filter criteria ---------------------------------------------------------
MIN_PORTFOLIO_USD=3000
MIN_MEMECOINS=5
MAX_MEMECOINS=500
MIN_TRADES_IN_WINDOW=5
ACTIVITY_WINDOW_DAYS=7
# Positions below this are treated as leftovers, not real memecoin holdings.
DUST_THRESHOLD_USD=25

# --- Monitoring --------------------------------------------------------------
DISCOVERY_INTERVAL_MS=3600000
REFRESH_INTERVAL_MS=3600000
ACTIVITY_POLL_INTERVAL_MS=300000
MAX_WATCHLIST_SIZE=1000
MIN_TRADE_ALERT_USD=500

# --- Telegram (optional; without it alerts are logged to stdout) -------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Token classification overrides -----------------------------------------
# Extra mints that should not count as memecoins.
MAJOR_MINTS_EXTRA=
STABLE_MINTS_EXTRA=

DB_PATH=data/fomo-tracker.db

# Portfolio-relative significance floor for counting a memecoin position.
MIN_POSITION_SHARE=0.01

# Jupiter free tier allows roughly one request per second.
PRICE_MIN_SPACING_MS=1500
MAX_MINTS_PRICED_PER_WALLET=400

# fomo-launched token mints (end in "fomo") to bootstrap holder discovery. A
# weaker signal than the sponsor path: graduated tokens trade on open DEXs, so
# their holders are not necessarily fomo users.
FOMO_SEED_MINTS=
FOMO_MINTS_PER_CYCLE=15
SIGNATURES_PER_FOMO_MINT=100

# Recent transactions inspected per seed wallet by discover-router.
SIGNATURES_PER_SEED=40
