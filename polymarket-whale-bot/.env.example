# ============================================
# Polymarket Whale Bot Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials!

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=-100your_channel_id
# Set to 1 to disable real Telegram sends during local testing
TELEGRAM_DRY_RUN=0

# --- Referral ---
REFERRAL_URL=https://t.me/YourBot?start=ref_yourcode
REFERRAL_BUTTON_TEXT=⚡ Trade on YourBot

# --- Admin Panel ---
# Your Telegram user ID (get it from @userinfobot on Telegram)
ADMIN_USER_ID=0

# --- Trade Filters ---
# Minimum trade size in USD required before an alert is emitted
MIN_TRADE_SIZE=10000
# Max alerts per wallet per market per day (prevents feed spam)
MAX_ALERTS_PER_WALLET_MARKET=5

# --- Polling Intervals ---
# Leaderboard wallet batch polling interval
POLL_INTERVAL_MS=15000
# Primary firehose polling interval for all public trades
FIREHOSE_POLL_INTERVAL_MS=5000
# Optional Hashdive whale discovery polling interval
HASHDIVE_POLL_INTERVAL_MS=120000
# Telegram channel scraper polling interval
SCRAPE_POLL_INTERVAL_MS=60000
# How often tracked leaderboard wallets are refreshed
LEADERBOARD_REFRESH_HOURS=6

# --- External APIs (optional) ---
# Enables resolved trader enrichment when provided
HASHDIVE_API_KEY=
# Real-time whale trade alerts via Struct WebSocket
# Free tier: 5000 credits/month, 1 concurrent connection
STRUCT_API_KEY=
# Enables recent USDC inflow detection when provided
POLYGONSCAN_API_KEY=

# --- Polynter API (free, no key needed) ---
# Set to 0 to disable Polynter market enrichment
POLYNTER_ENABLED=1

# --- Polymarket API URLs (defaults work fine) ---
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
